#!/usr/bin/env bash
# PoC 配置模板 — 复制为 config.env 后按需修改（config.env 应 git-ignore, 不提交凭据）
# 默认值对大多数本机冒烟场景可直接使用。

# 仓库根目录（默认自动推断自 git）
REPO_ROOT="$(git -C "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.." rev-parse --show-toplevel 2>/dev/null || echo "$HOME/projects/llm_app/cc_starter")"

# cct 可执行文件（先 cargo build；契约/冒烟脚本会 SKIP 若不存在）
CCT_BIN="${CCT_BIN:-$REPO_ROOT/target/debug/cct}"

# proxy 测试端口。默认 19191 = 真实端口。
# 注意: B012 前置检查同一端口; 运行 PoC 前须先迁移/停止旧实例（见 verify-B012）。
PROXY_PORT="${PROXY_PORT:-19191}"

# Unix 控制 socket 路径（修复后经 CCT_PROXY_SOCKET 覆盖; 留空 = 各脚本按临时目录隔离）
# CCT_PROXY_SOCKET=""

# 测试用假 api_key（B004-B007 Bearer 转发与 B005 脱敏断言）
TEST_API_KEY="${TEST_API_KEY:-sk-poc-test-0123456789abcdef}"

# stub 上游端口（B004/B006/B007/B008）
STUB_PORT="${STUB_PORT:-19200}"

# codex CLI（默认走 PATH）
# CODEX_BIN=codex
